VITE_MAPBOX_TOKEN=pk.replace_with_your_public_token
VITE_MAPBOX_STYLE=mapbox://styles/linroger023/cmoo6ced0003m01sa25xq2hig
OB_HOST=127.0.0.1
OB_PORT=2881
OB_USER=root
OB_DATABASE=chinahsr
OB_PASSWORD=replace_with_local_oceanbase_password
CHINAHSR_WORKERS=12
# OceanBase Desktop for macOS runs the database inside the OrbStack VM.
# Set to 1 to make the static server query that VM before trying host localhost.
CHINAHSR_OCEANBASE_VIA_ORB=1
# Optional: expose all 12306 train classes instead of only G/D/C high-speed classes.
CHINAHSR_OCEANBASE_INCLUDE_ALL_CLASSES=0
